{
  "name": "@binary-format/binary-format",
  "version": "1.0.0",
  "description": "a typescript library for reading and writing binary files to and from plain javascript objects",
  "keywords": [
    "arraybuffer",
    "arrays",
    "binary",
    "bit",
    "bits",
    "buffer",
    "buffers",
    "byte",
    "bytes",
    "dataview",
    "decode",
    "deserialize",
    "encode",
    "endian",
    "grammar",
    "pack",
    "packet",
    "parser",
    "read",
    "serialize",
    "unpack",
    "write"
  ],
  "homepage": "https://github.com/skratchdot/binary-format/",
  "bugs": {
    "url": "https://github.com/skratchdot/binary-format/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/skratchdot/binary-format.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run format:check && pnpm run lint && pnpm run tsc && pnpm run test:release && pnpm run cover && pnpm run test:package",
    "cover": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "prepublishOnly": "pnpm run check",
    "test": "vitest run",
    "test:package": "pnpm run build && node scripts/check-package.mjs",
    "test:release": "node --test scripts/release-policy.test.mjs",
    "tsc": "tsc --noEmit",
    "watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
